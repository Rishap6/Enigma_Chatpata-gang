# Backend Configuration
PROJECT_NAME="Family Grocery Allergy & Food Safety Intelligence"
API_V1_STR="/api"
SECRET_KEY="production-secret-key-change-this-in-real-deployment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database:
# For Supabase: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For local SQLite: sqlite+aiosqlite:///./family_intelligence.db
DATABASE_URL="sqlite+aiosqlite:///./family_intelligence.db"

# Optional Supabase direct keys
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","*"]
